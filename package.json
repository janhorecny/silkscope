{
  "name": "silkscope",
  "version": "0.1.0",
  "description": "Watch your coding agents spin. A live, local observatory for Claude Code and Codex: every session is a crawler walking a nebula of your codebase.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agents",
    "observability",
    "visualization",
    "canvas",
    "telemetry",
    "devtools",
    "local-first"
  ],
  "homepage": "https://github.com/janhorecny/silkscope#readme",
  "bugs": {
    "url": "https://github.com/janhorecny/silkscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhorecny/silkscope.git"
  },
  "license": "MIT",
  "author": "Jan Horecny",
  "type": "module",
  "bin": {
    "silkscope": "bin/silkscope.mjs"
  },
  "scripts": {
    "start": "node bin/silkscope.mjs",
    "demo": "node bin/silkscope.mjs --demo",
    "test": "node --test test/*.test.mjs",
    "brand": "sh brand/render.sh",
    "release": "node scripts/release.mjs"
  },
  "files": [
    "bin",
